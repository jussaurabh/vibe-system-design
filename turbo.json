{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT", "NODE_ENV", "AGENT_SERVER_URL", "AGENT_SERVER_API_KEY"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": ["NODE_ENV"]
    },
    "test:e2e": {
      "env": ["NODE_ENV"]
    },
    "format": {
      "cache": false
    }
  }
}
