{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT", "NODE_ENV", "AGENT_SERVER_URL", "AGENT_SERVER_API_KEY", "DATABASE_URL"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": ["NODE_ENV", "DATABASE_URL"]
    },
    "test:e2e": {
      "env": ["NODE_ENV"]
    },
    "format": {
      "cache": false
    },
    "evals": {
      "cache": false,
      "env": ["OPENROUTER_BASE_URL", "OPENROUTER_API_KEY", "OPENROUTER_DEFAULT_MODEL", "EVAL_JUDGE_MODEL", "EVAL_CATEGORIES"]
    }
  }
}
