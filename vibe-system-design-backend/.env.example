OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=

# Frontend origins that the API accepts. The value holds a comma separated
# list. Leave the var unset to use the default list.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Postgres connection for the running app. The transaction mode pooler on port
# 6543 is IPv4 only and has no session state.
DATABASE_URL=

# Postgres connection for the migrations. The session mode pooler on port 5432
# keeps a session, which a migration needs.
MIGRATION_DATABASE_URL=
