# Agent Server (LangGraph) base URL. Local dev: http://localhost:2024 (plan 001).
AGENT_SERVER_URL=http://localhost:2024
# Sent as x-api-key on every request. Optional for langgraph dev; required for self-host/cloud.
AGENT_SERVER_API_KEY=

# Frontend origins that the API accepts. The value holds a comma separated
# list. Leave the var unset to use the default list.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
