# Standalone Agent Server (langsmith/deploy-standalone-server).
DATABASE_URI=postgres://postgres:agent@postgres:5432/postgres
REDIS_URI=redis://redis:6379

# License validation phones home; required.
LANGSMITH_API_KEY=

# Runtime config for the graph itself.
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=

# Production swap (decisions D4/D6 in the spec):
#   DATABASE_URI -> Supabase DIRECT connection, db.<ref>.supabase.co:5432.
#   Never the :6543 transaction pooler (migrations + exactly-once queue need
#   session affinity). One deployment per database; separate databases on one
#   instance are fine.
#   REDIS_URI   -> managed Redis (e.g. Upstash). Redis holds no durable data.
