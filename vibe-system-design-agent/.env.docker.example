# Standalone Agent Server (langsmith/deploy-standalone-server).
# Supabase Postgres DIRECT connection (decision D4): db.<project-ref>.supabase.co:5432.
# Never the :6543 transaction pooler — migrations and the exactly-once queue need
# session affinity. One deployment per database; separate databases on one
# instance are fine.
DATABASE_URI=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
REDIS_URI=redis://redis:6379

# License validation phones home; required.
LANGSMITH_API_KEY=

# Runtime config for the graph itself.
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=

# Redis (decision D6): local container below for dev. Production uses managed
# Redis (e.g. Upstash). Redis holds no durable data.
